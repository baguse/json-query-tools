{
  "name": "json-query-tools",
  "displayName": "JSON Tools: JavaScript Methods",
  "description": "VS Code JSON query editor, history, and in-panel results.",
  "version": "0.1.0",
  "icon": "images/icon.png",
  "publisher": "Baguse",
  "repository": {
    "type": "git",
    "url": "https://github.com/baguse/json-query-tools"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:jsonQueryTools.openHistory",
    "onCommand:jsonQueryTools.transformWithExpression",
    "onCommand:jsonQueryTools.openScratchpad",
    "onCommand:jsonQueryTools.diffResult",
    "onCommand:jsonQueryTools.exportHistory",
    "onCommand:jsonQueryTools.importHistory"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jsonQueryTools.openHistory",
        "title": "JSON Tools: Open Query Editor"
      },
      {
        "command": "jsonQueryTools.openScratchpad",
        "title": "JSON Tools: Open JS Scratchpad (Standalone Mode)"
      },
      {
        "command": "jsonQueryTools.transformWithExpression",
        "title": "JSON Tools: Transform with Expression"
      },
      {
        "command": "jsonQueryTools.diffResult",
        "title": "JSON Tools: Compare Result with Original JSON (Diff View)"
      },
      {
        "command": "jsonQueryTools.exportHistory",
        "title": "JSON Tools: Export Query History as JSON"
      },
      {
        "command": "jsonQueryTools.importHistory",
        "title": "JSON Tools: Import Query History from JSON"
      }
    ],
    "configuration": {
      "title": "JSON Tools",
      "properties": {
        "jsonQueryTools.ollamaEndpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "URL of the Ollama API"
        },
        "jsonQueryTools.aiProvider": {
          "type": "string",
          "enum": ["ollama", "gemini"],
          "default": "ollama",
          "description": "AI Provider to use for query generation"
        },
        "jsonQueryTools.aiApiKey": {
          "type": "string",
          "default": "",
          "description": "API Key for cloud AI providers (e.g. Gemini). Securely stored via VS Code SecretStorage when entered in the Query Editor."
        },
        "jsonQueryTools.templateVariables": {
          "type": "object",
          "default": {},
          "description": "Custom template variables for expressions, URLs, headers, and bodies. Use {{variableName}}, {{$env.VAR_NAME}}, or built-ins: {{fileName}}, {{filePath}}, {{fileDir}}, {{workspaceFolder}}, {{url}}, {{host}}, {{method}}, {{alias}}."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=out/extension.js --format=cjs --sourcemap",
    "watch": "npm run build -- --watch",
    "package": "vsce package",
    "test": "node scripts/run-tests.js"
  },

  "devDependencies": {
    "@types/node": "^25.0.9",
    "@types/vscode": "^1.93.0",
    "esbuild": "^0.25.9",
    "typescript": "^5.4.0",
    "vsce": "^2.15.0"
  }
}
